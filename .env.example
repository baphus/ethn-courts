# ETHN configuration template. Never copy credentials from another client.
# Browser Auth/upload and server Storage must identify the same ETHN project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ETHN_STORAGE_URL=
ETHN_STORAGE_SERVICE_ROLE_KEY=
# First-owner setup only: random secret with at least 32 characters; never NEXT_PUBLIC_.
# Remove after setup. Empty disables setup; existing staff sign-in remains available.
ETHN_SETUP_KEY=

# Restricted ethn_checkout login only; never postgres/migration owner.
# Remote connections require verified TLS CA. Do not append sslmode URI overrides.
ETHN_DATABASE_URL=
ETHN_DATABASE_CA_FILE=
# Explicit local PostgreSQL exception, development/test + loopback only.
ETHN_ALLOW_LOCAL_DATABASE=

# Mail disabled until sender/origin/transport are deliberately configured.
ETHN_MAIL_ENABLED=0
ETHN_MAIL_FROM=
ETHN_APP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
CRON_SECRET=

# Optional Web Push: disabled until operator provisions VAPID and scheduler.
# Private key stays server-only; never use NEXT_PUBLIC_ for private material.
ETHN_WEB_PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Legacy references only; active ETHN booking must not use these as fallback.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_POOLER_URL=
DIRECT_DATABASE_URL=
MAIL_FROM=
APP_URL=
