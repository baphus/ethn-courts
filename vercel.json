{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ethn-operations",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/ethn-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/cron/proof-prune",
      "schedule": "0 3 1 * *"
    }
  ]
}
